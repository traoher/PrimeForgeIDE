{
    "name": "proton9-agent",
    "displayName": "Proton9 Agent",
    "description": "Proton9 server launcher — spawns and manages the P9 Python backend",
    "version": "0.3.0",
    "engines": {
        "vscode": "*"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "Proton9.restartServer",
                "title": "Proton9: Restart Server"
            }
        ],
        "configuration": {
            "title": "Proton9",
            "properties": {
                "Proton9.serverUrl": {
                    "type": "string",
                    "default": "ws://localhost:9321",
                    "description": "Proton9 WebSocket server URL"
                },
                "Proton9.maxIterations": {
                    "type": "number",
                    "default": 50,
                    "description": "Maximum agent iterations per task"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
        "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "@types/ws": "^8.5.0",
        "esbuild": "^0.27.3",
        "typescript": "^5.3.0"
    },
    "dependencies": {}
}